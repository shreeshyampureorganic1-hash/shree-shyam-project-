rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: Public can view, Admin can create/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: Public can view, Admin can modify
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Video Banners: Public can view hero banner, Admin can edit
    match /video_banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Website Settings: Public can view public branding/contacts, Admin can edit
    match /website_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Activity Logs: Super Admin audit logs
    match /activity_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
